@using System.Xml.Xsl
@inject IWebHostEnvironment Env
@{
    ViewData["Title"] = "Reisid";

    // andmed ja teisendus asuvad kaustas wwwroot/lib
    var lib = System.IO.Path.Combine(Env.WebRootPath, "lib");

    var xslt = new XslCompiledTransform();
    xslt.Load(System.IO.Path.Combine(lib, "reisidParing.xslt"));
    using var writer = new StringWriter();
    xslt.Transform(System.IO.Path.Combine(lib, "Reis.xml"), null, writer);
}

<h1>@ViewData["Title"]</h1>
<p class="text-muted">
    Andmed: <code>wwwroot/lib/Reis.xml</code>, teisendus: <code>wwwroot/lib/reisidParing.xslt</code>
</p>

@Html.Raw(writer.ToString())
